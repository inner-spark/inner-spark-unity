  lines:
  - speakerName: Sparky
    portrait: {fileID: 21300000, guid: 6936b9d0d20e600468c6f6817029d46e, type: 3}
    text: 'Here comes PS1, the big kid who brought 3D into the living room! Born from a partnership that fell apart, it grew up fast!'
  - speakerName: Sparky
    portrait: {fileID: 21300000, guid: 6936b9d0d20e600468c6f6817029d46e, type: 3}
    text: 'From here on, everything you''ve learned comes together. Take your time!'
