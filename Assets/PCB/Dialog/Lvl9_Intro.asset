  m_Script: {fileID: 11500000, guid: ddfcd7f15d1c2ba4c9fe0215478925bf, type: 3}
  m_Name: Lvl9_Intro
  m_EditorClassIdentifier: Assembly-CSharp::Pcb.DialogSequence
  lines:
  - speakerName: Sparky
    portrait: {fileID: 21300000, guid: 6936b9d0d20e600468c6f6817029d46e, type: 3}
    text: 'These are AND switches. They work as a team: their gate only opens while ALL of them are on.'
  - speakerName: Sparky
    portrait: {fileID: 21300000, guid: 6936b9d0d20e600468c6f6817029d46e, type: 3}
    text: 'Press one again to turn it off. Find every one before heading for the gate!'
