  m_Script: {fileID: 11500000, guid: ddfcd7f15d1c2ba4c9fe0215478925bf, type: 3}
  m_Name: Lvl13_Intro
  m_EditorClassIdentifier: Assembly-CSharp::Pcb.DialogSequence
  lines:
  - speakerName: Sparky
    portrait: {fileID: 21300000, guid: 6936b9d0d20e600468c6f6817029d46e, type: 3}
    text: 'Game Boy: Now you had the power in your hands! Playing under the blanket by torchlight, the glow was you.'
  - speakerName: Sparky
    portrait: {fileID: 21300000, guid: 6936b9d0d20e600468c6f6817029d46e, type: 3}
    text: 'Press Space on a pass holder to take its pass. Locks of the same colour only let you in while you carry it.'
  - speakerName: Sparky
    portrait: {fileID: 21300000, guid: 6936b9d0d20e600468c6f6817029d46e, type: 3}
    text: 'I can carry one pass at a time: taking a new one swaps out the old. Plan your swaps!'
